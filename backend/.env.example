# Nilai acuan; Go tidak membaca file ini otomatis.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
HTTP_ADDR=127.0.0.1:8080
# Jaringan proxy yang dipercaya untuk X-Forwarded-For; pisahkan dengan koma.
TRUSTED_PROXY_CIDRS=
# Gunakan role runtime terbatas, bukan migrator. Production wajib verify-full.
PLATFORM_DATABASE_URL=postgres://databrain_runtime@127.0.0.1:55432/databrain_dev?sslmode=disable
# Password mentah di-encode Go; jika variabel ini tidak disetel, pakai password URL.
PLATFORM_DATABASE_PASSWORD=CHANGE_ME
# Hanya untuk manage migrate up dari backend/. Production wajib verify-full.
MIGRATOR_DATABASE_URL=postgres://databrain_migrator@127.0.0.1:55432/databrain_dev?sslmode=disable
MIGRATOR_DATABASE_PASSWORD=CHANGE_ME
# Base64 standar dengan padding dari 32 byte acak. Simpan tetap antar-restart.
APP_SECRET_KEY=CHANGE_ME_BASE64_OF_32_RANDOM_BYTES
# Host/IP target yang diizinkan; bukan URL atau pola wildcard.
TARGET_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# File CA PEM opsional untuk verify-full; kosong memakai CA sistem.
TARGET_CA_FILE=
