# Reference values only. Go does not load this file automatically.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
HTTP_ADDR=127.0.0.1:8080
# Disposable PostgreSQL setup: see dev/README.md.
# Required by the HTTP server; restricted runtime role, never the migrator.
# Production requires sslmode=verify-full.
PLATFORM_DATABASE_URL=postgres://databrain_runtime:CHANGE_ME@127.0.0.1:55432/databrain_dev?sslmode=disable
# Used only by: go run ./cmd/manage migrate up (from backend/).
# Production requires sslmode=verify-full; never use a target role here.
MIGRATOR_DATABASE_URL=postgres://databrain_migrator:CHANGE_ME@127.0.0.1:55432/databrain_dev?sslmode=disable
# Required when auth/target features use config.LoadSecretKey; no default.
# Standard padded base64 of 32 cryptographically random bytes. Keep it stable.
APP_SECRET_KEY=CHANGE_ME_BASE64_OF_32_RANDOM_BYTES
